# Copy to .env.production on the server. Do not commit the copied file.
NODE_ENV=production
DOMAIN=portal.example.com
API_PORT=3001
API_HOST=0.0.0.0
CLIENT_ORIGIN=https://portal.example.com
CLIENT_URL=https://portal.example.com
JWT_SECRET=generate-a-64-character-random-secret

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=pcmo
MYSQL_USER=pcmo
MYSQL_PASSWORD=replace-with-a-long-unique-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-unique-password
MYSQL_CONNECTION_LIMIT=10

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-before-running-create-admin
ADMIN_DISPLAY_NAME=PCMO Administrator

# Leave blank only when the associated feature is intentionally disabled.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_AUTO_REPLY_ENABLED=false

# Limits are per IP per 15-minute window.
API_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# --- SMTP (Mailgun or your provider) for transactional emails ---
# Required for welcome, purchase, newsletter, OTP, certificate, event, and
# notification emails. Without these, emails are logged as not_configured.
# For Mailgun SMTP: host=smtp.mailgun.org, port=587, secure=false.
# SMTP_USER is usually postmaster@mg.YOUR_VERIFIED_DOMAIN.com and SMTP_PASS
# is the Mailgun SMTP password (or use user=api with your key-... API key).
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@mg.YOUR_DOMAIN.com
SMTP_PASS=replace-with-mailgun-smtp-password
EMAIL_FROM=PCMO <no-reply@mg.YOUR_DOMAIN.com>
ACTIVITY_NOTIFICATION_EMAIL=admin@example.com
